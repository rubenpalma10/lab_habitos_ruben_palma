rules_version = '2';

// Cada usuario solo puede leer y escribir dentro de usuarios/{su uid}.
// Copiar en Firebase Console → Firestore Database → Reglas → Publicar.
// Se verifica con el caso CP-11 (Rules Playground con otro uid).
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
